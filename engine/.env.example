# Copy this file to .env and fill in your own keys/URLs. Never commit .env
# itself (it's already covered by the root .gitignore).

# --- agent-service (Python/LangGraph) ---------------------------------------
# Where the Go engine sends /decide, /decide-batch and /world-decide calls.
# Run `agent-service` locally first (see agent-service/README.md) — its
# default port is 8000.
AGENT_SERVICE_URL="http://localhost:8000"

# --- Memory embeddings -------------------------------------------------------
# Only Gemini is called directly from Go now (for memory embeddings). The
# NPC decision LLM providers (Groq/Cerebras/Mistral/...) moved to
# agent-service/.env — the engine no longer talks to them directly.
GEMINI_API_KEY=

# --- Database (Supabase Postgres) -------------------------------------------
# Port 6543 is Supabase's Supavisor pooler in TRANSACTION mode, which does
# not support prepared statements. database/repository.go already forces
# pgx into simple-protocol mode in code (ConnConfig.DefaultQueryExecMode),
# so no `?default_query_exec_mode=...` query param is needed in this URL.
SUPABASE_DB_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# NOTE: the tick interval is currently hardcoded to 60s in main.go
# (world.RunLoop(ctx, 60*time.Second)) rather than read from an env var.
