# Copy this file to .env and fill in your own keys. Never commit .env itself
# (it's covered by the root .gitignore).

# --- NPC decision providers (fallback chain, in this order) -----------------
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
# Optional: a local Ollama model is tried last if every cloud provider fails
# (see app/llm/router.py — PROVIDER_TIMEOUT_SECONDS / OLLAMA_TIMEOUT_SECONDS).
# No key needed, just `ollama pull qwen3:0.6b` and have Ollama running.

# --- Memory (only used if the engine's HydrateFromDB path is exercised) -----
SUPABASE_DB_URL=

# --- Observability (Marco 11 — optional) ------------------------------------
# LangSmith trace collection for every LangGraph run (npc_graph, group_graph,
# world_graph). Leave LANGSMITH_TRACING unset/false to run with no tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=velryn
